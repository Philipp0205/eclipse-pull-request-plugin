<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<?pde?>
<!-- Target platform for standalone EGit Pull Request plugin -->
<target name="pullrequest" sequenceNumber="1">
  <locations>
    <!-- Eclipse Public License -->
    <location includeMode="slicer" includeAllPlatforms="false" includeSource="true" includeConfigurePhase="true" type="InstallableUnit">
      <unit id="org.eclipse.license.feature.group" version="0.0.0"/>
      <repository id="eclipse-public-license" location="https://download.eclipse.org/cbi/updates/license/2.0.2.v20181016-2210"/>
    </location>

    <!-- Eclipse Platform SDK and dependencies from 2025-06 release -->
    <location includeMode="slicer" includeAllPlatforms="false" includeSource="true" includeConfigurePhase="true" type="InstallableUnit">
      <unit id="org.eclipse.sdk.ide" version="0.0.0"/>
      <unit id="org.eclipse.e4.ui.workbench" version="0.0.0"/>
      <unit id="org.eclipse.pde.core" version="0.0.0"/>
      <repository location="https://download.eclipse.org/releases/2025-06"/>
    </location>

    <!-- Orbit dependencies: Hamcrest and JUnit for testing -->
    <location includeMode="slicer" includeAllPlatforms="false" includeSource="true" includeConfigurePhase="true" type="InstallableUnit">
      <unit id="org.hamcrest" version="3.0.0"/>
      <unit id="org.hamcrest.source" version="3.0.0"/>
      <unit id="org.junit" version="4.13.2.v20240929-1000"/>
      <unit id="org.junit.source" version="4.13.2.v20240929-1000"/>
      <unit id="junit-jupiter-api" version="5.12.2"/>
      <unit id="junit-jupiter-engine" version="5.12.2"/>
      <unit id="junit-platform-commons" version="1.12.2"/>
      <unit id="junit-platform-engine" version="1.12.2"/>
      <unit id="junit-platform-launcher" version="1.12.2"/>
      <unit id="junit-platform-runner" version="1.12.2"/>
      <repository location="https://download.eclipse.org/tools/orbit/simrel/orbit-aggregation/2025-06"/>
    </location>
  </locations>
</target>
