<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.eclipse.egit.pullrequest</groupId>
    <artifactId>pullrequest-parent</artifactId>
    <version>7.6.0-SNAPSHOT</version>
  </parent>

  <artifactId>org.eclipse.egit.pullrequest.repository</artifactId>
  <packaging>eclipse-repository</packaging>

  <name>Pull Request Review Update Site</name>

  <build>
    <plugins>
      <plugin>
        <groupId>org.eclipse.tycho</groupId>
        <artifactId>tycho-p2-repository-plugin</artifactId>
        <version>${tycho-version}</version>
        <configuration>
          <includeAllDependencies>false</includeAllDependencies>
          <createArtifactRepository>true</createArtifactRepository>
          <compress>true</compress>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>publish-site</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.eclipse.tycho.extras</groupId>
            <artifactId>tycho-p2-extras-plugin</artifactId>
            <version>${tycho-version}</version>
            <executions>
              <execution>
                <id>merge-with-published-site</id>
                <phase>verify</phase>
                <goals>
                  <goal>mirror</goal>
                </goals>
                <configuration>
                  <source>
                    <!-- Keep previously published versions. Eclipse clients
                         cache repository metadata and keep requesting the
                         exact version they first resolved. -->
                    <repository>
                      <url>file:${project.basedir}/../p2/</url>
                      <layout>p2</layout>
                    </repository>
                    <repository>
                      <url>file:${project.build.directory}/repository/</url>
                      <layout>p2</layout>
                    </repository>
                  </source>
                  <destination>${project.build.directory}/merged-site</destination>
                  <latestVersionOnly>false</latestVersionOnly>
                  <compress>true</compress>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
